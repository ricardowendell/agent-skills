#!/usr/bin/env sh
# Pre-commit health check for the skills repo.
#   - validate-skills.mjs : frontmatter, id/description budget, cross-tree drift
#   - run-evals.mjs --list --check : every evals/<id>/cases.md still parses
#   - node --test : the harness's own tests
#   - check-sensor-parity.mjs : the JS and Python docs-check sensors agree
#   - check-evidence.mjs : docs/evals citations exist and match the store
# Mirrors .github/workflows/skills.yml, scoped to this checkout (`--root skills`)
# so third-party installs under $HOME never leak warnings into a commit.
# Enable once with: git config core.hooksPath .githooks
set -e

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"
# Git exports its own GIT_DIR/GIT_INDEX_FILE to hooks. The tests below create
# their own repositories, so inherited values would make them commit into this
# one (2026-11-05: a worktree switched to feature/x and the main repo ended up
# with core.bare=true). Resolve ROOT first, then drop the hook's git context.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX GIT_COMMON_DIR
node scripts/validate-skills.mjs --root skills
node scripts/run-evals.mjs --root skills --list --check > /dev/null
node --test scripts/lib/evals/*.test.mjs > /dev/null
node --test scripts/lib/*.test.mjs > /dev/null
node --test skills/bootstrap-project-harness/scripts/*.test.mjs > /dev/null
node scripts/check-sensor-parity.mjs > /dev/null
node scripts/check-evidence.mjs > /dev/null
echo "skills pre-commit: ok"
