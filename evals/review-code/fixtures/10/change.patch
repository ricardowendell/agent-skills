@@ -0,0 +1,82 @@
+import { test } from "node:test"
+import assert from "node:assert/strict"
+
+import { retry } from "../src/retry.js"
+
+test("returns the first success without retrying", async () => {
+  let calls = 0
+  const result = await retry(async () => {
+    calls += 1
+    return "ok"
+  }, { attempts: 3, baseDelayMs: 1 })
+  assert.equal(result, "ok")
+  assert.equal(calls, 1)
+})
+
+test("retries a transient failure and returns the later success", async () => {
+  let calls = 0
+  const result = await retry(async () => {
+    calls += 1
+    if (calls < 3) throw new Error("503")
+    return "ok"
+  }, { attempts: 3, baseDelayMs: 1 })
+  assert.equal(result, "ok")
+  assert.equal(calls, 3)
+})
+
+test("rethrows the last error after the budget", async () => {
+  let calls = 0
+  await assert.rejects(
+    retry(async () => {
+      calls += 1
+      throw new Error(`failure ${calls}`)
+    }, { attempts: 2, baseDelayMs: 1 }),
+    /failure 2/,
+  )
+  assert.equal(calls, 2)
+})
+
+test("waits with exponential backoff between attempts", async () => {
+  const waits = []
+  let calls = 0
+  await assert.rejects(
+    retry(async () => {
+      calls += 1
+      throw new Error("503")
+    }, {
+      attempts: 4,
+      baseDelayMs: 10,
+      sleep: async (ms) => {
+        waits.push(ms)
+      },
+    }),
+    /503/,
+  )
+  assert.equal(calls, 4)
+  assert.deepEqual(waits, [10, 20, 40])
+})
+
+test("uses three attempts and a 100 ms base delay by default", async () => {
+  const waits = []
+  let calls = 0
+  await assert.rejects(
+    retry(async () => {
+      calls += 1
+      throw new Error("503")
+    }, {
+      sleep: async (ms) => {
+        waits.push(ms)
+      },
+    }),
+    /503/,
+  )
+  assert.equal(calls, 3)
+  assert.deepEqual(waits, [100, 200])
+})
+
+test("rejects a non-positive or non-integer budget", async () => {
+  await assert.rejects(retry(async () => "ok", { attempts: 0 }), RangeError)
+  await assert.rejects(retry(async () => "ok", { baseDelayMs: -1 }), RangeError)
+  await assert.rejects(retry(async () => "ok", { attempts: 1.5 }), RangeError)
+  await assert.rejects(retry(async () => "ok", { baseDelayMs: 2.5 }), RangeError)
+})
