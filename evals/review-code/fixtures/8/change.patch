+import { subtotal, total } from "../src/cart.js"
 
 test("subtotal multiplies price by quantity", () => {
   assert.equal(subtotal([{ price: 10, qty: 2 }]), 20)
@@ -10,3 +10,20 @@ test("subtotal multiplies price by quantity", () => {
 test("subtotal of an empty cart is zero", () => {
   assert.equal(subtotal([]), 0)
 })
+
+test("total adds tax to the subtotal", () => {
+  assert.equal(total({ items: [{ price: 10, qty: 2 }], taxRate: 0.2 }), 24)
+})
+
+test("total hides binary float noise", () => {
+  assert.equal(total({ items: [{ price: 1.1, qty: 1 }], taxRate: 0.1 }), 1.21)
+})
+
+test("total rounds the exact value, not the scaled one", () => {
+  assert.equal(total({ items: [{ price: 0.015, qty: 1 }], taxRate: 0 }), 0.01)
+  assert.equal(total({ items: [{ price: 1.1, qty: 1 }], taxRate: 0.1 }), 1.21)
+})
+
+test("total rejects a negative rate", () => {
+  assert.throws(() => total({ items: [], taxRate: -0.1 }), RangeError)
+})
