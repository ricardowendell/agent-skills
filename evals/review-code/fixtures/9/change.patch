diff --git a/src/cart.js b/src/cart.js
index bfb177f..fb4bd51 100644
--- a/src/cart.js
+++ b/src/cart.js
@@ -1,3 +1,9 @@
 export function subtotal(items) {
   return items.reduce((sum, item) => sum + item.price * item.qty, 0)
 }
+
+export function total(items, taxRate) {
+  if (taxRate < 0) throw new RangeError("taxRate must be zero or greater")
+  const value = subtotal(items) * (1 + taxRate)
+  return Number(value.toFixed(2))
+}
diff --git a/src/export.js b/src/export.js
new file mode 100644
index 0000000..305dd59
--- /dev/null
+++ b/src/export.js
@@ -0,0 +1,13 @@
+import { execSync } from "node:child_process"
+
+// `filename` is forwarded from the checkout request's query string, so the
+// browser chooses it. `items` comes from the posted cart.
+export function buildExportCommand(items, filename) {
+  const rows = items.map((item) => `${item.qty},${item.price}`).join("\\n")
+  return `printf '%b' "${rows}" > ${filename}`
+}
+
+export function exportCart(items, filename) {
+  execSync(buildExportCommand(items, filename))
+  return filename
+}
