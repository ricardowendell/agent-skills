{
  "name": "Sandbox Coder Policy",
  "slug": "sandbox-coder-policy",
  "description": "Fences the sandboxed coding agent: allowed models, egress domains, writable paths and executables. Keep every list as narrow as the task needs; fail closed.",
  "provider_type": "openshell",
  "spec": {
    "models": {
      "allow": ["<PROVIDER_PREFIXED_MODEL_REF>"]
    },
    "domains": {
      "allow": [
        "github.com",
        "api.github.com",
        "raw.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    },
    "filesystem": {
      "mode": "read-write",
      "read_write": ["/sandbox", "/tmp"]
    },
    "applications": {
      "allow": ["bash", "sh", "git", "python", "python3", "pip", "pytest", "ruff", "uv"]
    },
    "process": {
      "privileged": false
    }
  }
}
