diff --git a/src/cart.js b/src/cart.js
index bfb177f..67cd4a1 100644
--- a/src/cart.js
+++ b/src/cart.js
@@ -1,3 +1,12 @@
 export function subtotal(items) {
   return items.reduce((sum, item) => sum + item.price * item.qty, 0)
 }
+
+export function total(items, taxRate) {
+  if (taxRate < 0) throw new RangeError("taxRate must be zero or greater")
+  const value = subtotal(items) * (1 + taxRate)
+  // Round the exact value of the double to two decimals. Multiplying by 100
+  // first can invent a tie: 0.015 * 100 is 1.5, though the stored price is
+  // just below the half-cent.
+  return Number(value.toFixed(2))
+}
