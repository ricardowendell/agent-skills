index 1ae69b6..b09d177 100644
--- a/docs/specs/SPEC-0007-cart-tax.md
+++ b/docs/specs/SPEC-0007-cart-tax.md
@@ -15,7 +15,7 @@ Checkout needs a total that includes tax. Callers pass a tax rate as a fraction
 - **AC-1** — `total(items, taxRate)` returns the subtotal of `items` plus tax.
 - **AC-2** — the returned total is rounded to two decimals, so float noise (for
   example `24.000000000000004`) never reaches the caller.
-- **AC-3** — a negative `taxRate` throws a `RangeError`.
+- **AC-3** — a negative or non-finite `taxRate` throws a `RangeError`.
 
 ## Out of scope
 
diff --git a/src/cart.js b/src/cart.js
index bfb177f..27c1bb8 100644
--- a/src/cart.js
+++ b/src/cart.js
@@ -1,3 +1,9 @@
 export function subtotal(items) {
   return items.reduce((sum, item) => sum + item.price * item.qty, 0)
 }
+
+export function total(items, taxRate) {
+  if (taxRate < 0) throw new RangeError("taxRate must be zero or greater")
+  const value = subtotal(items) * (1 + taxRate)
+  return Math.round(value * 100) / 100
+}
