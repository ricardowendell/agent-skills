#!/usr/bin/env bash
set -e
ROOT=$(git rev-parse --show-toplevel)

npx --yes commitlint --edit "$1" 2>/dev/null || {
  echo "ERROR: Commit message must follow Conventional Commits."
  echo "Examples:"
  echo "  feat(scope): add feature description"
  echo "  fix(scope): correct behavior"
  echo "  refactor(scope): restructure without changing behavior"
  echo "  chore(deps): update dependencies"
  exit 1
}
