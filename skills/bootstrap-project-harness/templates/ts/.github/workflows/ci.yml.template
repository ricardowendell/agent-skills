name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  # A pinned dependency can become vulnerable without a code change, so the
  # audit and the coverage run nightly as well as on every pull request.
  schedule:
    - cron: "0 3 * * *"

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  check:
    runs-on: ubuntu-24.04
    strategy:
      fail-fast: false
      matrix:
        # The default runtime and the type-stripping floor: both must pass.
        node: ["24.15.0", "22.18.0"]
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: ${{ matrix.node }}
          cache: npm
      # Frozen install: npm ci rejects a lockfile that drifted from package.json.
      - run: npm ci
      - run: npm run docs:check
      - run: npm run check
      - run: npm run build --if-present
      - name: Audit (closed)
        run: node audit-gate.mjs --fail-on-unavailable
      - if: github.event_name == 'schedule'
        run: npm run coverage
